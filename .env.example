# --- OAuth (personal Gmail / Google account) ---
# Create a Desktop OAuth client in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:3847/oauth2callback

# --- Multi-account token storage ---
# file (default): ~/.config/google-workspace-mcp/accounts.json
# supabase: shared store for remote MCP — requires SUPABASE_* + encryption key below
# GOOGLE_ACCOUNTS_STORE=file
# GOOGLE_ACCOUNTS_PATH=

# Legacy single-account (auto-migrated into multi-account store on first use)
# GOOGLE_REFRESH_TOKEN=

# Optional: default account when accountEmail is omitted from MCP tools
# GOOGLE_DEFAULT_ACCOUNT_EMAIL=you@gmail.com

# Required when GOOGLE_ACCOUNTS_STORE=supabase — encrypt refresh tokens at rest
# Generate: openssl rand -hex 32
# GOOGLE_TOKEN_ENCRYPTION_KEY=

# Supabase (optional — enables multi-account persistence on Fly / shared backends)
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Required for `npm run authorize` and GET /authorize on a remote host
# AUTHORIZE_HASH_KEY=

# Token file path for legacy single-account migration source
# GOOGLE_TOKEN_PATH=

# --- Service account (Google Workspace domain-wide delegation) ---
# GOOGLE_SERVICE_ACCOUNT={"type":"service_account","client_email":"...","private_key":"..."}
# GOOGLE_WORKSPACE_USER_EMAIL=you@yourdomain.com

# Default Google Tasks list title when none is specified
GOOGLE_TASKS_DEFAULT_LIST=Action items

# --- Remote MCP (Fly.io or any HTTPS host) ---
# Required — protect the /mcp endpoint
# MCP_API_KEY=
# Remote OAuth callback (add the same URL in Google Cloud Console):
# GOOGLE_OAUTH_REDIRECT_URI=https://your-app.fly.dev/oauth2callback
# Authorize each account (repeat for every Gmail you need):
# GET https://your-app.fly.dev/authorize?hashKey=YOUR_AUTHORIZE_HASH_KEY&label=my-label
# Optional: make this account the default MCP account
# GET https://your-app.fly.dev/authorize?hashKey=...&label=my-label&default=1
# HOST=0.0.0.0
# PORT=8080
# MCP_ALLOWED_HOSTS=your-app.fly.dev
