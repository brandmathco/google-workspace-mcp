{
  "name": "google-workspace-mcp-setup",
  "version": "1.3.0",
  "private": true,
  "author": "BrandMatchCo <support@brandmatchco.com>",
  "description": "Installer app for Google Workspace MCP — guided setup for Cursor (no npm required).",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac dmg --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:all": "npm run build && electron-builder --mac dmg --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "com.brandmatchco.google-workspace-mcp-setup",
    "productName": "Google Workspace MCP Setup",
    "copyright": "Copyright © 2026 BrandMatchCo",
    "asar": true,
    "directories": {
      "output": "../dist-installers",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../packaging/mcp",
        "to": "mcp",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../packaging/runtime/active",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "minimumSystemVersion": "12.0"
    },
    "dmg": {
      "title": "Google Workspace MCP Setup ${version}",
      "iconSize": 110,
      "contents": [
        { "x": 140, "y": 200, "type": "file" },
        { "x": 400, "y": 200, "type": "link", "path": "/Applications" }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "verifyUpdateCodeSignature": false,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Google Workspace MCP Setup",
      "uninstallDisplayName": "Google Workspace MCP Setup"
    }
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "electron": "^35.1.2",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.2"
  },
  "license": "MIT"
}
