{
  "name": "google-workspace-mcp-setup",
  "version": "1.5.0",
  "private": true,
  "author": "BrandMatchGrowth <support@brandmatchco.com>",
  "homepage": "https://www.brandmatchgrowth.com/",
  "description": "BrandMatchGrowth installer for Google Workspace MCP \u2014 guided setup for Cursor (no npm required).",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac dmg --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:all": "npm run build && electron-builder --mac dmg --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "com.brandmatchgrowth.google-workspace-mcp-setup",
    "productName": "Google Workspace MCP Setup",
    "copyright": "Copyright \u00a9 2026 BrandMatchGrowth",
    "asar": true,
    "directories": {
      "output": "../dist-installers",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../packaging/mcp",
        "to": "mcp",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../packaging/runtime/active",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "AppIcon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "minimumSystemVersion": "12.0"
    },
    "dmg": {
      "title": "Google Workspace MCP Setup ${version}",
      "icon": "AppIcon.icns",
      "iconSize": 110,
      "contents": [
        {
          "x": 140,
          "y": 200,
          "type": "file"
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "verifyUpdateCodeSignature": false,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Google Workspace MCP Setup",
      "uninstallDisplayName": "Google Workspace MCP Setup by BrandMatchGrowth"
    }
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.2"
  },
  "license": "MIT",
  "overrides": {
    "cacheable-request": "7.0.4",
    "flat-cache": "4.0.1",
    "keyv": "4.5.4",
    "tar": {
      "6": "6.2.1",
      "7": "7.5.22"
    },
    "form-data": "4.0.6",
    "tmp": "0.2.7",
    "lodash": "4.18.1",
    "postcss": "8.5.26",
    "ip-address": "10.5.0",
    "js-yaml": {
      "4": "4.3.1"
    },
    "nanoid": {
      "3": "3.3.18"
    },
    "brace-expansion": {
      "1": "1.1.18",
      "2": "2.1.4",
      "5": "5.0.9"
    },
    "undici": {
      "6": "6.28.0",
      "7": "7.29.0"
    },
    "fast-uri": {
      "3": "3.1.6"
    }
  }
}
