{
  "name": "google-workspace-mcp",
  "version": "1.10.1",
  "type": "module",
  "description": "BrandMatchGrowth MCP server for Gmail, Google Calendar, Google Tasks, Google Analytics (GA4), and spend-safe Google Ads \u2014 multi-account OAuth, Cursor-ready",
  "license": "MIT",
  "author": "BrandMatchGrowth <support@brandmatchco.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/brandmathco/google-workspace-mcp.git"
  },
  "homepage": "https://www.brandmatchgrowth.com/",
  "bugs": {
    "url": "https://github.com/brandmathco/google-workspace-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gmail",
    "google-calendar",
    "google-tasks",
    "google-ads",
    "linkedin-ads",
    "google-analytics",
    "ga4",
    "cursor",
    "ai",
    "multi-account",
    "brandmatchgrowth"
  ],
  "bin": {
    "google-workspace-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "setup",
    "docs",
    "supabase/migrations",
    ".env.example",
    "cursor-mcp.example.json",
    "fly.toml.example",
    "Start Setup.command",
    "Start Setup.bat",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "setup": "tsx setup/wizard-server.ts",
    "setup:wizard": "tsx setup/wizard-server.ts",
    "authorize": "tsx scripts/authorize.ts",
    "authorize:linkedin": "tsx scripts/authorize-linkedin.ts",
    "authorize:all": "tsx scripts/authorize-all.ts",
    "authorize:all:auto": "tsx scripts/authorize-all-auto.ts",
    "typecheck": "tsc --noEmit",
    "desktop:prepare": "node scripts/prepare-desktop-bundle.mjs",
    "desktop:prepare:win": "node scripts/prepare-desktop-bundle.mjs --platform=win32 --arch=x64",
    "desktop:dist:mac": "npm run desktop:prepare && npm --prefix desktop install && npm --prefix desktop run dist:mac",
    "desktop:dist:win": "npm run desktop:prepare:win && npm --prefix desktop install && npm --prefix desktop run dist:win",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.2.1",
    "google-ads-api": "^24.1.0",
    "google-auth-library": "^9.14.0",
    "googleapis": "^144.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.13.10",
    "playwright": "^1.62.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "tar": "7.5.22",
    "form-data": "4.0.6",
    "tmp": "0.2.7",
    "lodash": "4.18.1",
    "postcss": "8.5.26",
    "ip-address": "10.5.0",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "brace-expansion": "5.0.9",
    "undici": "7.29.0",
    "fast-uri": "3.1.6",
    "hono": "4.13.3",
    "@hono/node-server": {
      "1": "1.19.17"
    },
    "shell-quote": "1.10.0",
    "serialize-javascript": "6.0.2",
    "undici@8": "8.10.0",
    "vite": "6.4.3"
  },
  "resolutions": {
    "form-data": "4.0.6",
    "tmp": "0.2.7",
    "lodash": "4.18.1",
    "postcss": "8.5.26",
    "ip-address": "10.5.0",
    "hono": "4.13.3",
    "playwright": "1.62.1",
    "tar": "7.5.22",
    "@hono/node-server": "1.19.17",
    "fast-uri": "3.1.6"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
