{
  "name": "google-workspace-mcp",
  "version": "1.3.0",
  "type": "module",
  "description": "MCP server for Gmail, Google Calendar, and Google Tasks — multi-account OAuth, Cursor-ready",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/brandmathco/google-workspace-mcp.git"
  },
  "homepage": "https://github.com/brandmathco/google-workspace-mcp#readme",
  "bugs": {
    "url": "https://github.com/brandmathco/google-workspace-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gmail",
    "google-calendar",
    "google-tasks",
    "cursor",
    "ai",
    "multi-account"
  ],
  "bin": {
    "google-workspace-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "setup",
    "docs",
    "supabase/migrations",
    ".env.example",
    "cursor-mcp.example.json",
    "fly.toml.example",
    "Start Setup.command",
    "Start Setup.bat",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "setup": "tsx setup/wizard-server.ts",
    "setup:wizard": "tsx setup/wizard-server.ts",
    "authorize": "tsx scripts/authorize.ts",
    "authorize:all": "tsx scripts/authorize-all.ts",
    "authorize:all:auto": "tsx scripts/authorize-all-auto.ts",
    "typecheck": "tsc --noEmit",
    "desktop:prepare": "node scripts/prepare-desktop-bundle.mjs",
    "desktop:prepare:win": "node scripts/prepare-desktop-bundle.mjs --platform=win32 --arch=x64",
    "desktop:dist:mac": "npm run desktop:prepare && npm --prefix desktop install && npm --prefix desktop run dist:mac",
    "desktop:dist:win": "npm run desktop:prepare:win && npm --prefix desktop install && npm --prefix desktop run dist:win",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.2.1",
    "google-auth-library": "^9.14.0",
    "googleapis": "^144.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.13.10",
    "playwright": "^1.49.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
